#!/bin/bash
# Enhanced Documentation Ingestion with Pipeline Support
# Backward compatible with original behavior, adds --pipeline mode
#
# Usage: ./tools/ingest <url> [options]
# Options:
#   --pipeline          Use three-stage pipeline (fetch → extract → embed)
#   --stages STAGES     Run specific stages only (e.g., "fetch,extract")
#   --force             Force re-ingestion (ignore cache)
#   --output NAME       Output name (default: derived from URL)
#   --provider PROVIDER Embedding provider (ollama|openai)
#   --quiet             Suppress progress messages

set -e

# Configuration
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
OUTPUT_DIR="$PROJECT_ROOT/claude-outputs"

# Default options
URL=""
OUTPUT_NAME=""
USE_PIPELINE=false
STAGES="fetch,extract,embed"
FORCE=false
PROVIDER="${EMBEDDING_PROVIDER:-ollama}"
QUIET=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --pipeline)
      USE_PIPELINE=true
      shift
      ;;
    --stages)
      STAGES="$2"
      shift 2
      ;;
    --force)
      FORCE=true
      shift
      ;;
    --output)
      OUTPUT_NAME="$2"
      shift 2
      ;;
    --provider)
      PROVIDER="$2"
      shift 2
      ;;
    --quiet)
      QUIET=true
      shift
      ;;
    *)
      URL="$1"
      shift
      ;;
  esac
done

# Validate URL
if [ -z "$URL" ]; then
  echo "Usage: $0 <documentation-url> [options]"
  echo ""
  echo "Options:"
  echo "  --pipeline       Use three-stage pipeline (10x faster on re-run)"
  echo "  --stages STAGES  Run specific stages (fetch,extract,embed)"
  echo "  --force         Force re-ingestion"
  echo "  --output NAME   Output filename"
  echo "  --provider PROV Embedding provider (ollama|openai)"
  echo ""
  echo "Examples:"
  echo "  $0 https://docs.claude.com/en/docs/claude-code/hooks"
  echo "  $0 https://docs.claude.com/en/docs/claude-code/hooks --pipeline"
  echo "  $0 https://docs.claude.com/en/docs/claude-code/hooks --pipeline --stages fetch,extract"
  exit 1
fi

# Derive output name if not specified
if [ -z "$OUTPUT_NAME" ]; then
  OUTPUT_NAME=$(echo "$URL" | sed 's|.*/||' | sed 's|[^a-zA-Z0-9-]|_|g')
fi

OUTPUT_FILE="$OUTPUT_DIR/${OUTPUT_NAME}.json"

# Helper functions
log_info() {
  if [ "$QUIET" = false ]; then
    echo "$1"
  fi
}

log_step() {
  if [ "$QUIET" = false ]; then
    echo ""
    echo "$1"
  fi
}

# Start timer
START_TIME=$(date +%s)

# Header
log_info "📚 Claude-Driven Documentation Ingestion"
log_info "========================================"
log_info "📍 URL: $URL"
log_info "📁 Output: $OUTPUT_FILE"
log_info "🔧 Mode: $([ "$USE_PIPELINE" = true ] && echo "Pipeline" || echo "Monolithic")"
log_info ""

# Check if pipeline tools exist
if [ "$USE_PIPELINE" = true ]; then
  if [ ! -x "$SCRIPT_DIR/fetch" ] || [ ! -x "$SCRIPT_DIR/extract" ] || [ ! -x "$SCRIPT_DIR/embed" ]; then
    log_info "⚠️  Pipeline tools not found. Falling back to monolithic mode."
    USE_PIPELINE=false
  fi
fi

if [ "$USE_PIPELINE" = true ]; then
  # ========================================
  # PIPELINE MODE - Three-stage processing
  # ========================================

  log_info "🚀 Running in pipeline mode (stages: $STAGES)"

  # Convert stages to array
  IFS=',' read -ra STAGE_ARRAY <<< "$STAGES"

  # Stage 1: Fetch (if included)
  if [[ " ${STAGE_ARRAY[@]} " =~ " fetch " ]]; then
    log_step "1️⃣  Fetch Stage - Getting HTML content..."

    FETCH_OPTS=""
    [ "$FORCE" = true ] && FETCH_OPTS="$FETCH_OPTS --force"
    [ "$QUIET" = true ] && FETCH_OPTS="$FETCH_OPTS --quiet"

    "$SCRIPT_DIR/fetch" "$URL" $FETCH_OPTS || {
      echo "❌ Fetch stage failed"
      exit 1
    }

    log_info "   ✓ HTML cached/retrieved"
  fi

  # Stage 2: Extract (if included)
  if [[ " ${STAGE_ARRAY[@]} " =~ " extract " ]]; then
    log_step "2️⃣  Extract Stage - Understanding with Claude..."

    EXTRACT_OPTS="--output $OUTPUT_FILE"
    [ "$FORCE" = true ] && EXTRACT_OPTS="$EXTRACT_OPTS --force"
    [ "$QUIET" = true ] && EXTRACT_OPTS="$EXTRACT_OPTS --quiet"

    "$SCRIPT_DIR/extract" "$URL" $EXTRACT_OPTS || {
      echo "❌ Extract stage failed"
      exit 1
    }

    # Show extraction summary
    if [ "$QUIET" = false ] && [ -f "$OUTPUT_FILE" ]; then
      SECTIONS=$(jq '.sections | length' "$OUTPUT_FILE" 2>/dev/null || echo 0)
      CODE_EXAMPLES=$(jq '[.sections[].codeExamples | length] | add' "$OUTPUT_FILE" 2>/dev/null || echo 0)
      KEY_CONCEPTS=$(jq '[.sections[].keyConcepts | length] | add' "$OUTPUT_FILE" 2>/dev/null || echo 0)

      log_info "   ✓ Extracted: $SECTIONS sections, $CODE_EXAMPLES examples, $KEY_CONCEPTS concepts"
    fi
  fi

  # Stage 3: Embed (if included)
  if [[ " ${STAGE_ARRAY[@]} " =~ " embed " ]]; then
    log_step "3️⃣  Embed Stage - Generating embeddings..."

    EMBED_OPTS="--provider $PROVIDER"
    [ "$FORCE" = true ] && EMBED_OPTS="$EMBED_OPTS --force"
    [ "$QUIET" = true ] && EMBED_OPTS="$EMBED_OPTS --quiet"

    "$SCRIPT_DIR/embed" "$OUTPUT_FILE" $EMBED_OPTS || {
      echo "❌ Embed stage failed"
      exit 1
    }

    log_info "   ✓ Embeddings generated with $PROVIDER"
  fi

else
  # ========================================
  # MONOLITHIC MODE - Original behavior
  # ========================================

  # Check ingestion status
  mkdir -p "$OUTPUT_DIR"

  if [ -f "$PROJECT_ROOT/build/services/ingestion-tracker.js" ] && [ -f "$PROJECT_ROOT/claude-outputs/ingestion-manifest.json" ]; then
    log_info "🔍 Checking ingestion status..."

    # Create check script
    cat > "$PROJECT_ROOT/check-single-ingestion-temp.js" << EOF
import { IngestionTracker } from './build/services/ingestion-tracker.js';
const tracker = new IngestionTracker();
const status = tracker.checkIngestionStatus('$URL');
console.log(JSON.stringify(status));
EOF

    status_json=$(cd "$PROJECT_ROOT" && node check-single-ingestion-temp.js 2>/dev/null || echo '{"needsUpdate":true}')
    needs_update=$(echo "$status_json" | jq -r '.needsUpdate')
    days_since=$(echo "$status_json" | jq -r '.daysSinceIngestion // "N/A"')

    if [ "$FORCE" = false ] && [ "$needs_update" = "false" ]; then
      log_info "⚠️  This page was already ingested ${days_since} days ago"
      log_info ""
      read -p "Do you want to re-ingest it anyway? (y/N) " -n 1 -r
      echo ""
      if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "Skipping ingestion. Page is still fresh."
        rm -f "$PROJECT_ROOT/check-single-ingestion-temp.js"
        exit 0
      fi
    fi

    rm -f "$PROJECT_ROOT/check-single-ingestion-temp.js"
  fi

  # Step 1: Use Claude to read documentation
  log_step "1️⃣ Reading documentation with Claude..."

  # Load prompt
  PROMPT_FILE="$PROJECT_ROOT/docs/ingestion/prompts/claude-docs.prompt.md"
  if [ -f "$PROMPT_FILE" ]; then
    PROMPT=$(cat "$PROMPT_FILE")
    log_info "   📋 Using enhanced Claude documentation prompt"
  else
    PROMPT="Please read this documentation page and extract structured information as JSON. Include sections, code examples, key concepts, and best practices. Output only valid JSON."
    log_info "   ⚠️  Using fallback prompt"
  fi

  log_info "   🤖 Asking Claude to read: $URL"
  log_info "   ⏳ This may take 10-60 seconds..."

  claude "$PROMPT

Please read: $URL" > "$OUTPUT_FILE.raw"

  # Clean output
  log_info "   🧹 Cleaning Claude's output..."
  if [ -f "$SCRIPT_DIR/utils/clean-json" ]; then
    bash "$SCRIPT_DIR/utils/clean-json" "$OUTPUT_FILE.raw" "$OUTPUT_FILE"
  else
    # Simple cleaning
    sed -n '/{/,$p' "$OUTPUT_FILE.raw" | sed -n '1,/^}$/p' > "$OUTPUT_FILE.tmp1"
    if grep -q '```' "$OUTPUT_FILE.tmp1"; then
      sed 's/^```json$//' "$OUTPUT_FILE.tmp1" | sed 's/^```$//' > "$OUTPUT_FILE"
    else
      mv "$OUTPUT_FILE.tmp1" "$OUTPUT_FILE"
    fi
    rm -f "$OUTPUT_FILE.tmp1"
  fi
  rm -f "$OUTPUT_FILE.raw"

  # Step 2: Validate JSON
  log_step "2️⃣ Validating JSON output..."
  if jq . "$OUTPUT_FILE" > /dev/null 2>&1; then
    log_info "   ✅ Valid JSON"

    # Show preview
    if [ "$QUIET" = false ]; then
      echo ""
      echo "   📋 Extracted content preview:"
      echo "   - Title: $(jq -r '.pageTitle' "$OUTPUT_FILE")"
      echo "   - Sections: $(jq '.sections | length' "$OUTPUT_FILE")"
      echo "   - Code examples: $(jq '[.sections[].codeExamples | length] | add' "$OUTPUT_FILE")"
      echo "   - Key concepts: $(jq '[.sections[].keyConcepts | length] | add' "$OUTPUT_FILE")"
    fi
  else
    log_info "   ❌ Invalid JSON output"
    exit 1
  fi

  # Step 3: Process into embeddings
  log_step "3️⃣ Processing into embeddings..."
  log_info "   🔄 Generating embeddings with $PROVIDER..."

  npm run process-claude "$OUTPUT_FILE" -- --provider "$PROVIDER"
fi

# Calculate duration
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
MINUTES=$((DURATION / 60))
SECONDS=$((DURATION % 60))

# Summary
log_info ""
log_info "✅ Documentation successfully ingested!"
log_info ""

if [ $MINUTES -gt 0 ]; then
  log_info "⏱️  Total time: ${MINUTES}m ${SECONDS}s"
else
  log_info "⏱️  Total time: ${SECONDS}s"
fi

if [ "$USE_PIPELINE" = true ] && [ "$FORCE" = false ]; then
  log_info "💡 Tip: Next run will use cache and complete in <5 seconds"
fi

log_info ""
log_info "🔍 Try searching:"
log_info "   npm run search \"$(jq -r '.sections[0].keyConcepts[0] // "your query"' "$OUTPUT_FILE" 2>/dev/null)\""