#!/bin/bash
# Claude-Driven Batch Documentation Ingestion
# This script processes multiple documentation pages using Claude Code

set -e

# Configuration
OUTPUT_DIR="./claude-outputs"
LOG_FILE="$OUTPUT_DIR/ingestion-log.txt"
DELAY_SECONDS=30
FORCE_UPDATE=false

# Parse arguments
for arg in "$@"; do
  case $arg in
    --force)
      FORCE_UPDATE=true
      echo "🔄 Force update enabled - will re-ingest all pages"
      ;;
    --help)
      echo "Usage: $0 [--force]"
      echo "  --force  Re-ingest all pages regardless of freshness"
      exit 0
      ;;
  esac
done

# Create output directory if it doesn't exist
mkdir -p "$OUTPUT_DIR"

# Initialize log
echo "Claude Documentation Ingestion - $(date)" > "$LOG_FILE"
echo "========================================" >> "$LOG_FILE"

# Determine the project root directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Generate fresh URL configuration
node "$PROJECT_ROOT/build/scripts/generate-url-config.js" > "$PROJECT_ROOT/tools/url-config.sh" 2>/dev/null

# Source the URL configuration
source "$PROJECT_ROOT/tools/url-config.sh"

# Documentation pages to ingest (from configuration)
# All pages from src/config/documentation-urls.ts
PAGES=(
  "$DOCS_URL_OVERVIEW"
  "$DOCS_URL_QUICKSTART"
  "$DOCS_URL_SLASH_COMMANDS"
  "$DOCS_URL_HOOKS"
  "$DOCS_URL_SETTINGS"
  "$DOCS_URL_MCP"
  "$DOCS_URL_MEMORY"
  "$DOCS_URL_COMMON_WORKFLOWS"
  "$DOCS_URL_INTERACTIVE_MODE"
  "$DOCS_URL_CLI_REFERENCE"
)

BATCH_START_TIME=$(date +%s)

echo "🚀 Starting batch documentation ingestion"
echo "📁 Output directory: $OUTPUT_DIR"
echo "📝 Processing ${#PAGES[@]} documentation pages"
echo ""

# Load prompt template
PROMPT_TEMPLATE=$(cat "$PROJECT_ROOT/docs/ingestion/prompts/claude-docs.prompt.md")

# Create a simple Node.js script to check ingestion status
cat > "$PROJECT_ROOT/check-batch-status-temp.js" << 'EOF'
import { IngestionTracker } from './build/services/ingestion-tracker.js';
const tracker = new IngestionTracker();
const url = process.argv[2];
const force = process.argv[3] === '--force';
const status = tracker.checkIngestionStatus(url, { force });
console.log(JSON.stringify(status));
EOF

# Process each page
for i in "${!PAGES[@]}"; do
  page="${PAGES[$i]}"
  page_name=$(echo "$page" | sed 's|.*/||' | sed 's|[^a-zA-Z0-9-]|_|g')
  output_file="$OUTPUT_DIR/${page_name}.json"
  
  echo "[$((i+1))/${#PAGES[@]}] Processing: $page"
  echo "  → Output: $output_file"
  
  # Check if ingestion is needed
  if [ -f "$PROJECT_ROOT/build/services/ingestion-tracker.js" ] && [ "$FORCE_UPDATE" != "true" ]; then
    status_json=$(cd "$PROJECT_ROOT" && node check-batch-status-temp.js "$page" 2>/dev/null || echo '{"needsUpdate":true}')
    needs_update=$(echo "$status_json" | jq -r '.needsUpdate')
    reason=$(echo "$status_json" | jq -r '.reason // "unknown"')
    days_since=$(echo "$status_json" | jq -r '.daysSinceIngestion // "N/A"')
    
    if [ "$needs_update" = "false" ]; then
      echo "  ⏭️  Skipping (ingested ${days_since} days ago, still fresh)"
      echo "Skipped (fresh): $page" >> "$LOG_FILE"
      continue
    else
      echo "  → Needs update: $reason"
    fi
  elif [ "$FORCE_UPDATE" = "true" ]; then
    echo "  → Force update requested"
  fi
  
  # Log the operation
  echo "" >> "$LOG_FILE"
  echo "Processing: $page at $(date)" >> "$LOG_FILE"
  
  # Use Claude to read the documentation
  echo "  → Reading with Claude..."
  echo "  → This may take 10-60 seconds..."
  if claude "$PROMPT_TEMPLATE

Please read: $page" > "${output_file}.raw" 2>> "$LOG_FILE"; then
    echo "  ✓ Claude read successful"
    
    # Clean up Claude's output (handle all common formats)
    echo "  → Cleaning output..."
    # First, extract just the JSON (from first { to last })
    sed -n '/{/,$p' "${output_file}.raw" | sed -n '1,/^}$/p' > "$output_file.tmp1"

    # Then remove any markdown code block markers if present
    if grep -q '```' "$output_file.tmp1"; then
      sed 's/^```json$//' "$output_file.tmp1" | sed 's/^```$//' > "$output_file"
    else
      mv "$output_file.tmp1" "$output_file"
    fi

    rm -f "${output_file}.raw" "$output_file.tmp1"
    
    # Validate JSON
    if jq . "$output_file" > /dev/null 2>&1; then
      echo "  ✓ Valid JSON output"
      
      # Process the output
      echo "  → Processing embeddings..."
      if npm run process-claude "$output_file" >> "$LOG_FILE" 2>&1; then
        echo "  ✓ Embeddings generated successfully"
        echo "Success: $page" >> "$LOG_FILE"
      else
        echo "  ❌ Failed to generate embeddings"
        echo "Failed embeddings: $page" >> "$LOG_FILE"
      fi
    else
      echo "  ❌ Invalid JSON output from Claude"
      echo "Invalid JSON: $page" >> "$LOG_FILE"
      # Save the invalid output for debugging
      mv "$output_file" "${output_file}.invalid"
    fi
  else
    echo "  ❌ Claude read failed"
    echo "Failed read: $page" >> "$LOG_FILE"
  fi
  
  # Add delay between requests (except for last item)
  if [ $i -lt $((${#PAGES[@]} - 1)) ]; then
    echo "  ⏳ Waiting ${DELAY_SECONDS}s before next request..."
    sleep $DELAY_SECONDS
  fi
  
  echo ""
done

# Clean up temporary script
rm -f "$PROJECT_ROOT/check-batch-status-temp.js"

BATCH_END_TIME=$(date +%s)
BATCH_DURATION=$((BATCH_END_TIME - BATCH_START_TIME))
BATCH_MINUTES=$((BATCH_DURATION / 60))
BATCH_SECONDS=$((BATCH_DURATION % 60))

echo "✅ Batch ingestion complete!"
echo ""
if [ $BATCH_MINUTES -gt 0 ]; then
  echo "⏱️  Total time: ${BATCH_MINUTES}m ${BATCH_SECONDS}s"
else
  echo "⏱️  Total time: ${BATCH_SECONDS}s"
fi
echo ""
echo "📊 Summary:"
echo "  - Output files: $OUTPUT_DIR/"
echo "  - Log file: $LOG_FILE"
echo "  - Valid JSON files: $(find "$OUTPUT_DIR" -name "*.json" -type f | wc -l)"
echo "  - Skipped fresh pages: $(grep -c "Skipped (fresh)" "$LOG_FILE" 2>/dev/null || echo "0")"
echo "  - Failed pages: $(grep -c "Failed" "$LOG_FILE" 2>/dev/null || echo "0")"
echo ""
echo "🔍 You can now search the ingested documentation:"
echo "  npm run search \"your query\""
echo ""
echo "💡 Tips:"
echo "  - To check ingestion status: npm run ingestion-status"
echo "  - To force re-ingestion: $0 --force"
echo "  - To re-run failed pages: grep 'Failed' $LOG_FILE"