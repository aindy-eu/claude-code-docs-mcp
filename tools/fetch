#!/bin/bash
# Fetch and clean documentation - Store only essential content
#
# Usage: ./tools/fetch <url> [options]
# Options:
#   --force             Skip cache check
#   --ttl DAYS          Override default TTL (7 days)
#   --output FILE       Save to specific file (default: stdout)
#   --quiet             Suppress info messages

set -e

# Configuration
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Default options
URL=""
FORCE=false
TTL_DAYS=7
OUTPUT_FILE=""
QUIET=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --force)
      FORCE=true
      shift
      ;;
    --ttl)
      TTL_DAYS="$2"
      shift 2
      ;;
    --output)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --quiet)
      QUIET=true
      shift
      ;;
    *)
      URL="$1"
      shift
      ;;
  esac
done

# Validate URL
if [ -z "$URL" ]; then
  echo "Error: URL is required"
  echo "Usage: $0 <url> [--force] [--ttl DAYS] [--output FILE]"
  exit 1
fi

# Helper functions
log_info() {
  if [ "$QUIET" = false ]; then
    echo "[FETCH-CLEAN] $1" >&2
  fi
}

log_error() {
  echo "[ERROR] $1" >&2
}

# Function to extract clean content from HTML
extract_content() {
  local html_file="$1"
  local temp_clean=$(mktemp)

  # Try to find main content area
  if grep -q '<main' "$html_file"; then
    sed -n '/<main/,/<\/main>/p' "$html_file" > "$temp_clean"
  elif grep -q 'role="main"' "$html_file"; then
    sed -n '/role="main"/,/<\/footer\|<\/body/p' "$html_file" > "$temp_clean"
  elif grep -q '<article' "$html_file"; then
    sed -n '/<article/,/<\/article>/p' "$html_file" > "$temp_clean"
  else
    # Fallback: extract body
    sed -n '/<body/,/<\/body>/p' "$html_file" > "$temp_clean"
  fi

  # Clean up the content
  # Remove script tags and their content
  sed -i.bak '/<script/,/<\/script>/d' "$temp_clean"
  # Remove style tags and their content
  sed -i.bak '/<style/,/<\/style>/d' "$temp_clean"
  # Remove Next.js hydration data
  sed -i.bak '/__NEXT_DATA__/d' "$temp_clean"
  # Remove inline event handlers
  sed -i.bak 's/ on[a-z]*="[^"]*"//g' "$temp_clean"
  # Clean up excessive whitespace
  sed -i.bak 's/^[[:space:]]*$//' "$temp_clean"

  # Remove backup files
  rm -f "$temp_clean.bak"

  cat "$temp_clean"
  rm -f "$temp_clean"
}

# Build if necessary
cd "$PROJECT_ROOT"
if [ ! -f "build/services/structured-cache.js" ]; then
  log_info "Building TypeScript files..."
  npm run build >/dev/null 2>&1
fi

# Check cache using Node.js
CACHE_CHECK=$(node --no-warnings --input-type=module -e "
import { StructuredCache } from './build/services/structured-cache.js';
import { readFileSync, existsSync } from 'fs';

const url = process.argv[1];
const force = process.argv[2] === 'true';
const ttlDays = parseInt(process.argv[3] || '7');

const cache = new StructuredCache(url);
const paths = cache.getCachePaths(url);

// Check if content exists and is recent
const contentPath = paths.htmlPath.replace('index.html', 'content.html');

if (!force && existsSync(contentPath) && existsSync(paths.metaPath)) {
  const meta = JSON.parse(readFileSync(paths.metaPath, 'utf-8'));
  const cachedDate = new Date(meta.cachedAt);
  const ageDays = Math.floor((new Date() - cachedDate) / (1000 * 60 * 60 * 24));

  if (ageDays < ttlDays) {
    console.log(JSON.stringify({
      status: 'cached',
      ageDays: ageDays,
      contentPath: contentPath,
      cachePath: cache.urlToPath(url)
    }));
    process.exit(0);
  }
}

console.log(JSON.stringify({
  status: 'needs-fetch',
  contentPath: contentPath,
  cachePath: cache.urlToPath(url)
}));
" "$URL" "$FORCE" "$TTL_DAYS")

# Parse cache check result
CACHE_STATUS=$(echo "$CACHE_CHECK" | jq -r '.status' 2>/dev/null || echo "error")
CONTENT_PATH=$(echo "$CACHE_CHECK" | jq -r '.contentPath' 2>/dev/null)
CACHE_PATH=$(echo "$CACHE_CHECK" | jq -r '.cachePath' 2>/dev/null)

if [ "$CACHE_STATUS" = "cached" ]; then
  AGE_DAYS=$(echo "$CACHE_CHECK" | jq -r '.ageDays')
  log_info "Using cached content ($AGE_DAYS days old)"

  if [ -n "$OUTPUT_FILE" ]; then
    cp "$CONTENT_PATH" "$OUTPUT_FILE"
    log_info "Saved to $OUTPUT_FILE"
  else
    # Content is already in cache, no need to output
    log_info "Content cached at: $CONTENT_PATH"
  fi
  exit 0
fi

# Fetch from network
log_info "Fetching from network..."

TEMP_HTML=$(mktemp)
curl -sS \
  -H "User-Agent: Mozilla/5.0 (compatible; DocIngestionBot/1.0)" \
  -H "Accept: text/html,application/xhtml+xml" \
  -H "Accept-Language: en-US,en;q=0.9" \
  "$URL" > "$TEMP_HTML" || {
  log_error "Failed to fetch URL"
  rm -f "$TEMP_HTML"
  exit 1
}

# Extract clean content
log_info "Extracting content..."
CLEAN_CONTENT=$(extract_content "$TEMP_HTML")

# Check content size
CONTENT_SIZE=$(echo "$CLEAN_CONTENT" | wc -c)
log_info "Content size: $(($CONTENT_SIZE / 1024))KB"

# Save to cache
log_info "Saving to cache..."
node --no-warnings --input-type=module -e "
import { StructuredCache } from './build/services/structured-cache.js';
import { writeFileSync, mkdirSync } from 'fs';
import { dirname } from 'path';

const url = process.argv[1];
const content = process.argv[2];

const cache = new StructuredCache(url);
const paths = cache.getCachePaths(url);
const contentPath = paths.htmlPath.replace('index.html', 'content.html');

// Ensure directory exists
mkdirSync(dirname(contentPath), { recursive: true });

// Save content
writeFileSync(contentPath, content, 'utf-8');

// Update metadata
const meta = {
  url: url,
  cachedAt: new Date().toISOString(),
  size: content.length,
  type: 'content'
};
writeFileSync(paths.metaPath, JSON.stringify(meta, null, 2), 'utf-8');

console.log('Cached at: ' + cache.urlToPath(url));
" "$URL" "$CLEAN_CONTENT"

# Save to output file if specified
if [ -n "$OUTPUT_FILE" ]; then
  echo "$CLEAN_CONTENT" > "$OUTPUT_FILE"
  log_info "Saved to $OUTPUT_FILE"
fi
# Content is always saved to cache, no need to output to stdout

# Cleanup
rm -f "$TEMP_HTML"

log_info "Complete: ${CACHE_PATH}content.html"

# Update manifest to track fetch status
"$SCRIPT_DIR/update-manifest" --url "$URL" fetched