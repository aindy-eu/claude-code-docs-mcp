#!/bin/bash
# Format raw Claude response into clean JSON
#
# Usage: ./tools/format-response <raw-response-file> [options]
# Options:
#   --output FILE       Save JSON to specific file (default: stdout)
#   --quiet             Suppress info messages

set -e

# Configuration
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Default options
RAW_FILE=""
OUTPUT_FILE=""
QUIET=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --output)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --quiet)
      QUIET=true
      shift
      ;;
    *)
      RAW_FILE="$1"
      shift
      ;;
  esac
done

# Validate input
if [ -z "$RAW_FILE" ]; then
  echo "Error: Raw response file is required"
  echo "Usage: $0 <raw-response-file> [--output FILE]"
  exit 1
fi

if [ ! -f "$RAW_FILE" ]; then
  echo "Error: File not found: $RAW_FILE"
  exit 1
fi

# Helper functions
log_info() {
  if [ "$QUIET" = false ]; then
    echo "[FORMAT] $1" >&2
  fi
}

log_error() {
  echo "[ERROR] $1" >&2
}

# Process the raw response
log_info "Processing raw response from: $RAW_FILE"

# Create temp file for cleaned JSON
CLEAN_JSON=$(mktemp)

# Extract JSON from the response - be more forgiving
# First check if it starts with JSON
if head -1 "$RAW_FILE" | grep -q '^[[:space:]]*{'; then
  # Direct JSON output (ideal case)
  log_info "Found direct JSON output"
  cp "$RAW_FILE" "$CLEAN_JSON"
elif grep -q '```json' "$RAW_FILE"; then
  # JSON wrapped in markdown code block
  log_info "Found JSON in markdown code block"
  sed -n '/```json/,/```/p' "$RAW_FILE" | sed '1d;$d' > "$CLEAN_JSON"
elif grep -q '```' "$RAW_FILE"; then
  # Code block without json tag
  log_info "Found code block without json tag"
  sed -n '/```/,/```/p' "$RAW_FILE" | sed '1d;$d' > "$CLEAN_JSON"
else
  # Claude added preamble - find first { and extract from there
  log_info "Extracting JSON from Claude's response with preamble"
  sed -n '/{/,$p' "$RAW_FILE" > "$CLEAN_JSON"
fi

# Additional cleanup - remove any trailing text after the final }
# Find the last } and truncate there
if [ -s "$CLEAN_JSON" ]; then
  # Use awk to find matching braces and extract complete JSON
  awk 'BEGIN { brace_count = 0; capturing = 0; output = "" }
    {
      for(i=1; i<=length($0); i++) {
        char = substr($0, i, 1)
        if (char == "{") {
          brace_count++
          capturing = 1
        }
        if (capturing) {
          output = output char
        }
        if (char == "}" && capturing) {
          brace_count--
          if (brace_count == 0) {
            print output
            exit
          }
        }
      }
      if (capturing) {
        output = output "\n"
      }
    }' "$RAW_FILE" > "$CLEAN_JSON.tmp" && mv "$CLEAN_JSON.tmp" "$CLEAN_JSON"
fi

# Validate JSON
if ! jq . "$CLEAN_JSON" > /dev/null 2>&1; then
  log_error "Invalid JSON in raw response"
  log_info "Debug with: cat $RAW_FILE"

  # Show first few lines for debugging
  if [ "$QUIET" = false ]; then
    echo "First 10 lines of raw response:" >&2
    head -10 "$RAW_FILE" >&2
  fi

  rm -f "$CLEAN_JSON"
  exit 1
fi

log_info "Successfully extracted valid JSON"

# Pretty print and output
if [ -n "$OUTPUT_FILE" ]; then
  jq . "$CLEAN_JSON" > "$OUTPUT_FILE"
  log_info "Formatted JSON saved to: $OUTPUT_FILE"
else
  jq . "$CLEAN_JSON"
fi

# Show summary if not quiet
if [ "$QUIET" = false ]; then
  SECTIONS=$(jq '.sections | length' "$CLEAN_JSON" 2>/dev/null || echo 0)
  CODE_EXAMPLES=$(jq '[.sections[]?.codeExamples? | length] | add' "$CLEAN_JSON" 2>/dev/null || echo 0)
  KEY_CONCEPTS=$(jq '[.sections[]?.keyConcepts? | length] | add' "$CLEAN_JSON" 2>/dev/null || echo 0)

  log_info "Extraction summary:"
  log_info "  - Sections: $SECTIONS"
  log_info "  - Code examples: $CODE_EXAMPLES"
  log_info "  - Key concepts: $KEY_CONCEPTS"
fi

# Cleanup
rm -f "$CLEAN_JSON"