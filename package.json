{
  "name": "claude-code-docs-mcp",
  "version": "1.0.0",
  "description": "MCP server for Claude Code documentation RAG system",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "claude-code-docs-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "cli": "tsx src/cli/index.ts",
    "cli:help": "tsx src/cli/index.ts --help",
    "cli:list": "tsx src/cli/index.ts list",
    "debug": "npx @modelcontextprotocol/inspector node build/index.js",
    "integration-test": "tsx src/utils/integration-test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\"",
    "prepare": "npm run build",
    "search": "tsx src/cli/index.ts search",
    "setup": "tsx src/utils/setup-collection.ts",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:runner": "tsx tests/test-runner.ts",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "watch": "tsc --watch"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.1",
    "listr2": "^9.0.4",
    "node-fetch": "^3.3.2",
    "ollama": "^0.5.9",
    "openai": "^4.67.1",
    "ora": "^9.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@modelcontextprotocol/inspector": "latest",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "claude-code",
    "documentation",
    "embeddings",
    "mcp",
    "qdrant",
    "rag"
  ],
  "author": "Your Name",
  "license": "MIT"
}
